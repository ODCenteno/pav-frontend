---
export const prerender = true;

import BaseLayout from "@/layouts/BaseLayout.astro";
import HeroPage from "@/components/main/hero/HeroPage.astro";
import FavoritesSection from "@/components/main/favorites/FavoritesSection.astro";
import CtaSection from "@/components/main/CTA/CtaSection.astro";
import { communityActions } from "@/components/main/CTA/ctaActions";
import { navigation } from "@/utils/navigation";
import { useTranslations } from "@/i18n/utils";
import { getCommunities, getListingsWithFallback, toStrapiLocale } from "@/lib/cms";

const locale = toStrapiLocale(Astro.currentLocale || "en");
const t = useTranslations(locale);

const [listings, communities] = await Promise.all([getListingsWithFallback(locale), getCommunities(locale)]);
---

<BaseLayout
  siteTitle={t("favoritesPage.seo.siteTitle")}
  ogTitle={t("favoritesPage.seo.ogTitle")}
  siteDescription={t("favoritesPage.seo.siteDescription")}
  ogDescription={t("favoritesPage.seo.ogDescription")}
>
  <HeroPage
    slot="Hero"
    title={t("favoritesPage.heroTitle")}
    description={t("favoritesPage.heroDesc")}
    backgroundImage="/images/pav-01.jpg"
  />

  <FavoritesSection listings={listings} locale={locale} />

  <CtaSection
    title={t("favoritesPage.cta.title")}
    description={t("favoritesPage.cta.description")}
    actions={communityActions(communities, (slug) => navigation.community(slug, locale))}
    locale={locale}
  />
</BaseLayout>

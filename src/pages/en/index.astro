---
export const prerender = true;

import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/main/hero/Hero.astro";
import PopupManager from "@/components/popup/PopupManager.astro";
import QuickFacts from "@/components/main/quickFacts/QuickFacts.astro";
import MapSection from "@/components/main/mapSection/MapSection.astro";
import CtaSection from "@/components/main/CTA/CtaSection.astro";
import { communityActions, communityVisitKey, favoritesAction } from "@/components/main/CTA/ctaActions";
import { useTranslations } from "@/i18n/utils";
import { navigation } from "@/utils/navigation";
import { getHomepageWithFallback } from "@/lib/cms";
import { getCommunities } from "@/lib/cms/community";
import { homeQuickFacts } from "@/components/main/quickFacts/homeQuickFacts";

const locale = Astro.currentLocale || "en";
const t = useTranslations(locale);
const [homepage, communities] = await Promise.all([
  getHomepageWithFallback(locale),
  getCommunities(locale),
]);

const homepageFacts = homeQuickFacts(homepage.quickFacts.items);
---

<BaseLayout siteTitle={t("page.index.siteTitle")} ogTitle={t("page.index.ogTitle")} siteDescription={t("page.index.siteDescription")} ogDescription={t("page.index.ogDescription")}>
  <Hero slot="Hero" data={homepage.hero} communities={communities} />
  <PopupManager slot="categories" />
  <QuickFacts header={homepage.quickFacts.header} items={homepageFacts} />
  <MapSection data={homepage.mapSection} communities={communities} regionMapImage={homepage.regionMapImage} regionMapImageAlt={homepage.regionMapImageAlt} locale={locale} />
  <CtaSection
    title={homepage.finalCta.title}
    description={homepage.finalCta.description}
    actions={[
      ...communityActions(
        communities,
        (slug) => navigation.community(slug, locale),
        (c) => t(communityVisitKey(c.slug) ?? "communityDetail.cta.button", { name: c.name }),
      ),
      favoritesAction(t("finalCta.favoritesBtn"), navigation.favorites(locale)),
    ]}
  />
</BaseLayout>

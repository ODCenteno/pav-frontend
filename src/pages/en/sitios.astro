---
export const prerender = true;

import BaseLayout from "@/layouts/BaseLayout.astro";
import HeroPage from "@/components/main/hero/HeroPage.astro";
import CardMain from "@/components/cards/CardMain.astro";
import ExpCTA from "@/components/main/experiences/ExpCTA.astro";

import SitesExplorer from "@/components/main/categories/SitesExplorer.tsx";
import { carouselCategoryOf, carouselChips } from "@/components/main/categories/carousel";
import { useTranslations } from "@/i18n/utils";
import { getListingsWithFallback } from "@/lib/cms";
import type { Listing } from "@/types/listing.type";
import { navigation } from "@/utils/navigation";

const locale = "en";
const t = useTranslations(locale);

const allSites: Listing[] = await getListingsWithFallback(locale);

// The 4 contract categories (contract §1); legacy slugs map to their
// current category, so the page works before and after the migration.
const categories = carouselChips(locale);

const groupedSites = categories
  .map((cat) => ({
    ...cat,
    items: allSites.filter((item) => carouselCategoryOf(item) === cat.id),
  }))
  .filter((group) => group.items.length > 0);
---

<BaseLayout siteTitle={t("page.sites.siteTitle")} ogTitle={t("page.sites.ogTitle")} siteDescription={t("page.sites.siteDescription")} ogDescription={t("page.sites.ogDescription")}>
  <HeroPage
    slot="Hero"
    title={t("sitesPage.heroTitle")}
    description={t("sitesPage.heroDesc")}
    backgroundImage="/images/pav-01.jpg"
  />

  <section class="sites-explorer section-padding">
    <div class="container">
      <SitesExplorer
        client:load
        locale={locale}
        categories={categories}
        translations={{
          all: t("categories.all"),
          noResults: t("sitesPage.empty"),
          searchPlaceholder: t("sitesPage.searchPlaceholder"),
        }}
      />

      <!-- Categories Sections -->
      {
        groupedSites.map((group) => (
          <div class="category-section" id={`category-${group.id}`}>
            <div class="category-header">
              <h2 class="category-title">{group.label}</h2>
              <span class="item-count">
                {t("sitesPage.itemCount", { count: group.items.length.toString() })}
              </span>
            </div>

            <div class="horizontal-carousel">
              {group.items.map((item) => (
                <div class="carousel-item">
                  <CardMain item={item} currentLang={locale} />
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <ExpCTA title={t("aboutPage.cta.title")} description={t("aboutPage.cta.desc")} btnText={t("aboutPage.cta.btn")} href={navigation.about(locale)} />
</BaseLayout>

<style>
  .sites-explorer {
    background-color: var(--color-surface);
    position: relative;
  }

  .sites-explorer::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background-image: var(--wave-divider);
    background-repeat: repeat-x;
    background-size: 1440px 4px;
    pointer-events: none;
  }

  .category-section {
    margin-bottom: var(--space-lg);
  }

  .category-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--space-sm);
    border-bottom: 1px solid transparent;
    background-image: var(--gradient-sea-border);
    background-size: 100% 1px;
    background-repeat: no-repeat;
    background-position: bottom;
    padding-bottom: var(--space-xs);
  }

  .category-title {
    font-size: var(--text-2xl);
    margin: 0;
    position: relative;
    padding-left: var(--space-md);
  }

  .category-title::before {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 4px;
    height: 80%;
    background: var(--gradient-sea-bar);
    border-radius: 2px;
  }

  .item-count {
    font-size: var(--text-xs);
    color: var(--color-primary);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .horizontal-carousel {
    display: flex;
    gap: var(--space-md);
    overflow-x: auto;
    padding-bottom: var(--space-md);
    scroll-snap-type: x mandatory;
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none; /* IE 10+ */
    -webkit-overflow-scrolling: touch;
  }

  .horizontal-carousel::-webkit-scrollbar {
    display: none; /* Chrome/Safari */
  }

  /* Items stretch to the row height; the card inside fills the item. */
  .carousel-item {
    flex: 0 0 300px;
    display: flex;
    flex-direction: column;
    scroll-snap-align: start;
  }

  @media (min-width: 768px) {
    .carousel-item {
      flex: 0 0 340px;
    }
  }

  @media (max-width: 767px) {
    .horizontal-carousel {
      gap: var(--space-sm);
    }
  }
</style>

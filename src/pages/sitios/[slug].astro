---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHero from "../../components/site-detail/SiteHero.astro";
import SiteSummary from "../../components/site-detail/SiteSummary.astro";
import SiteInfoPanel from "../../components/site-detail/SiteInfoPanel.astro";
import SiteTips from "../../components/site-detail/SiteTips.astro";
import SiteGallery from "../../components/site-detail/SiteGallery.astro";
import RelatedSites from "../../components/site-detail/RelatedSites.astro";
import MemberStrip from "../../components/site-detail/MemberStrip.astro";
import StoryTimeline from "../../components/site-detail/StoryTimeline.astro";
import ProductList from "../../components/site-detail/ProductList.astro";
import SocialLinks from "../../components/site-detail/SocialLinks.astro";
import StickyActionBar from "../../components/site-detail/StickyActionBar.tsx";
import { useTranslations } from "../../i18n/utils";
import { getListingBySlugWithFallback, getListingSlugsWithFallback, toStrapiLocale } from "../../lib/cms";
import CtaSection from "@/components/main/CTA/CtaSection.astro";
import { favoritesAction, listingCtaActions } from "@/components/main/CTA/ctaActions";
import { getCommunities } from "@/lib/cms/community";
import { navigation } from "@/utils/navigation";
import { listingContactChannels } from "@/utils/listingContact";

export const prerender = true;

export async function getStaticPaths() {
  const slugs = await getListingSlugsWithFallback(toStrapiLocale("es"));
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const item = slug ? await getListingBySlugWithFallback(slug, toStrapiLocale("es")) : null;

if (!item) {
  return new Response("Listing not found", { status: 404 });
}

const locale = "es-MX";
const t = useTranslations(locale);
const communities = await getCommunities(locale);
// The listing's own community (or both when it has none), then favorites.
const ctaActions = [
  ...listingCtaActions(
    item.community,
    communities,
    (communitySlug) => navigation.community(communitySlug, locale),
    (community) => t("communityDetail.cta.button", { name: community.name }),
  ),
  favoritesAction(t("finalCta.favoritesBtn"), navigation.favorites(locale)),
];

const title = item.name[locale];
const description = item.description?.[locale];
const categoryLabel = item.category?.name?.[locale] || "";
const tags = item.tags || [];
const location = item.location;
const categoryColor = item.category?.color || "#68a299";


const labels = {
  about: t("siteDetailPage.labels.about"),
  directions: t("siteDetailPage.actions.directions"),
  contact: t("siteDetailPage.actions.contact"),
  call: t("siteDetailPage.actions.call"),
  email: t("siteDetailPage.actions.email"),
  favorite: t("siteDetailPage.actions.favorite"),
  favoriteActive: t("siteDetailPage.actions.favoriteActive"),
  share: t("siteDetailPage.actions.share"),
  info: t("siteDetailPage.labels.info"),
  hours: t("siteDetailPage.labels.hours"),
  price: t("siteDetailPage.labels.price"),
  amenities: t("siteDetailPage.labels.amenities"),
  tips: t("siteDetailPage.labels.tips"),
  gallery: t("siteDetailPage.labels.gallery") || "Gallery",
  related: t("siteDetailPage.labels.related") || "Related Sites",
  behind: t("siteDetailPage.labels.behind"),
  stories: t("siteDetailPage.labels.stories"),
  products: t("siteDetailPage.labels.products"),
  follow: t("siteDetailPage.labels.follow"),
};

// hideContact listings show no contact channel at all (map and directions stay).
const { contact, social } = listingContactChannels(item);

const contactActions = {
  whatsapp: contact.whatsapp,
  phone: contact.phone,
  email: contact.email,
  instagram: contact.instagram,
  facebook: contact.facebook,
};

const schedule = item.schedule?.text;
const amenities = item.amenities || [];
const tips = (item.recommendations || []).filter(r => (r.description || "").trim() !== "");
---

<BaseLayout siteTitle={`${title} | Puerto Agua Verde`} siteDescription={description}>
  <SiteHero slot="Hero" id={item.id} title={title} categoryLabel={categoryLabel} image={item.media?.mainImageUrl || ""} logos={item.media?.logoUrls} tags={tags} shortDescription={item.shortDescription?.[locale]} labels={labels} />

  <SiteSummary description={description} labels={labels} contactActions={contactActions} location={location} categoryColor={categoryColor}>
    <SiteGallery title={labels.gallery} images={item.media?.galleryUrls || []} noContainer={true} />
  </SiteSummary>

  {item.products && item.products.length > 0 && (
    <ProductList title={labels.products} products={item.products} />
  )}

  <SiteInfoPanel labels={labels} schedule={schedule} price={item.pricing?.price} amenities={amenities} />

  {item.members && item.members.length > 0 && (
    <MemberStrip title={labels.behind} members={item.members} />
  )}

  {social.length > 0 && (
    <section class="container site-social">
      <SocialLinks title={labels.follow} social={social} />
    </section>
  )}

  {tips.length > 0 && <SiteTips labels={labels} recommendations={tips} />}

  {item.stories && item.stories.length > 0 && (
    <StoryTimeline title={labels.stories} stories={item.stories} />
  )}

  <RelatedSites title={labels.related} relatedIds={item.relatedSites} currentLang={locale} />

  <CtaSection
    title={t("siteDetailPage.cta.title")}
    description={t("siteDetailPage.cta.desc")}
    actions={ctaActions}
    locale={locale}
  />

  <StickyActionBar
    client:visible
    id={item.id}
    lat={item.location?.lat}
    lng={item.location?.lng}
    whatsapp={contact.whatsapp}
    labels={{
      directions: labels.directions,
      contact: labels.contact,
      favorite: labels.favorite,
      favoriteActive: labels.favoriteActive,
    }}
  />
</BaseLayout>

---
export const prerender = true;

import BaseLayout from "@/layouts/BaseLayout.astro";
import HeroPage from "@/components/main/hero/HeroPage.astro";
import ExpBlock from "@/components/main/experiences/ExpBlock.astro";
import ExpCTA from "@/components/main/experiences/ExpCTA.astro";
import { useTranslations } from "@/i18n/utils";
import { getExperiencesPageWithFallback, toStrapiLocale } from "@/lib/cms";
import { navigation } from "@/utils/navigation";

const locale = toStrapiLocale(Astro.currentLocale || "es");
const t = useTranslations(locale);

const experiencesPage = await getExperiencesPageWithFallback(locale);

const heroBgImage = experiencesPage?.hero.images?.[0]?.url || "/images/pav-landscape-12.webp";
const heroTitle = experiencesPage?.hero.title || t("experiencesPage.heroTitle");
const heroDesc = experiencesPage?.hero.description || t("experiencesPage.heroDesc");
const introTitle = experiencesPage?.introHeader?.title || t("experiencesPage.introTitle");
const introDesc = experiencesPage?.introHeader?.subtitle || t("experiencesPage.introDesc");
const sectionsTitle = experiencesPage?.sectionsHeader?.title || t("experiencesPage.featuredTitle");
const sectionsDesc = experiencesPage?.sectionsHeader?.subtitle;
const sections = experiencesPage?.sections || [];
---

<BaseLayout
  siteTitle={t("page.experiences.siteTitle")}
  ogTitle={t("page.experiences.ogTitle")}
  siteDescription={t("page.experiences.siteDescription")}
  ogDescription={t("page.experiences.ogDescription")}
>
  <HeroPage
    slot="Hero"
    title={heroTitle}
    description={heroDesc}
    backgroundImage={heroBgImage}
  />

  {introTitle && (
    <section class="experiences-intro section-padding">
      <div class="container text-center">
        <h2 class="experiences-title">{introTitle}</h2>
        {introDesc && <p class="max-w-700">{introDesc}</p>}
      </div>
    </section>
  )}

  {sections.length > 0 && (
    <>
      {(sectionsTitle || sectionsDesc) && (
        <section class="experiences-sections-header section-padding">
          <div class="container text-center">
            {sectionsTitle && <h2 class="experiences-title">{sectionsTitle}</h2>}
            {sectionsDesc && <p class="max-w-700">{sectionsDesc}</p>}
          </div>
        </section>
      )}

      <div class="experiences-sections">
        {sections.map((block) => (
          <ExpBlock block={block} locale={locale} />
        ))}
      </div>
    </>
  )}

  {experiencesPage?.finalCta && (
    <ExpCTA
      title={experiencesPage.finalCta.title}
      description={experiencesPage.finalCta.description}
      btnText={experiencesPage.finalCta.buttonLabel}
      href={experiencesPage.finalCta.buttonLink || navigation.sites(locale)}
    />
  )}
</BaseLayout>

<style>
  .experiences-intro {
    background-color: var(--color-surface);
  }

  .experiences-sections-header {
    background-color: var(--color-bone);
    background-image: var(--gradient-sea-glass-warm);
    position: relative;
  }

  .experiences-sections-header::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background-image: var(--wave-divider);
    background-repeat: repeat-x;
    background-size: 1440px 4px;
  }

  .experiences-title {
    position: relative;
    display: inline-block;
    padding-left: var(--space-md);
    margin-bottom: var(--space-md);
    font-size: var(--text-2xl);
  }

  .experiences-title::before {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 4px;
    height: 80%;
    background: var(--gradient-sea-bar);
    border-radius: 2px;
  }

  .text-center .experiences-title::before {
    left: var(--space-xs);
  }

  .text-center .experiences-title {
    padding-left: calc(var(--space-md) + var(--space-xs));
  }

  .max-w-700 {
    max-width: 700px;
    margin: 0 auto;
    white-space: pre-line;
  }
</style>
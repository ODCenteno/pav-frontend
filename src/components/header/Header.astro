---
import "./header.css";
import Image from "astro/components/Image.astro";
import favicon from "../../../public/favicon.ico";
import { useTranslations } from "../../i18n/utils";
import { navigation, communityPath, goodPracticesPath, favoritesPath } from "@/utils/navigation";
import { getCommunities } from "@/lib/cms/community";
import SvgIcon from "../icons/SvgIcon.astro";
import { SITE_BRAND_NAME, brandLines } from "@/config/brand";
import CommunityBadge from "@/components/community-badge/CommunityBadge.astro";

interface Props {
  logoImage?: string;
  logoShortName?: string;
}

const { logoImage, logoShortName } = Astro.props;
const brandName = logoShortName || SITE_BRAND_NAME;
const logoAlt = `${brandName} Logo`;

const locale = Astro.currentLocale || "es";
const t = useTranslations(locale);
const communities = await getCommunities(locale);

const locales = ["en", "es"];
const alternateLocaleCode = locales.find((l) => l !== locale);

let alternateLang;
if (alternateLocaleCode) {
  alternateLang = {
    locale: alternateLocaleCode,
    url: navigation.toggleLocale(Astro.url.pathname, locale, alternateLocaleCode),
  };
}
---

<header class="site-header">
  <div class="container header-container">
    <a href={navigation.home(locale)} class="logo">
      <span class="logo-icon">
        {logoImage
          ? <img src={logoImage} alt={logoAlt} width={32} height={32} class="logo-img" />
          : <Image src={favicon} alt={logoAlt} width={32} height={32} />}
      </span><span class="logo-text">{brandLines(brandName).map((line) => <span class="logo-text__line">{line}</span>)}</span>
    </a>
    
    <!-- Desktop Navigation Only -->
    <nav class="main-nav desktop-only" id="main-navigation" aria-label={t("nav.mainLabel")}>
      <ul class="main-nav--ul">
        <li><a class="main-nav--link main-nav--link--compact" href={goodPracticesPath(locale)} data-key="nav_goodPractices">{t("nav.goodPractices")}</a></li>
        <li class="main-nav--item" data-community-menu>
          <button type="button" class="main-nav--link main-nav--toggle" aria-expanded="false" aria-controls="community-submenu">
            {t("nav.communities")}
            <svg class="main-nav--chevron" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
              <path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
          <ul class="main-nav--submenu" id="community-submenu">
            {communities.map((community) => (
              <li>
                <a class="main-nav--sublink" href={communityPath(community.slug, locale)}>
                  <CommunityBadge community={community} size="sm" locale={locale} decorative />
                  <span>{community.name}</span>
                </a>
              </li>
            ))}
          </ul>
        </li>
        <li><a class="main-nav--link" href={favoritesPath(locale)} data-key="nav_favorites">{t("nav.favorites")}</a></li>
        {
          alternateLang && (
            <li>
              <a id="i18n-toggle" href={alternateLang.url} class="btn btn-outline btn-sm" lang={alternateLang.locale}>
                {alternateLang.locale.substring(0, 2).toUpperCase()}
              </a>
            </li>
          )
        }
      </ul>
    </nav>

    <div class="header-right">
      <button class="mobile-menu-btn" aria-label={t("nav.openMenu")} aria-expanded="false" aria-controls="mobile-menu-overlay">
        <SvgIcon name="menu" class="menu-icon-svg" />
      </button>
    </div>
  </div>
</header>

<script>
  import { navigate } from "astro:transitions/client";
  import { initCommunityMenu } from "./communityMenu";

  let cleanupCommunityMenu: (() => void) | undefined;

  document.addEventListener("astro:page-load", () => {
    cleanupCommunityMenu?.();
    const communityMenu = document.querySelector<HTMLElement>("[data-community-menu]");
    cleanupCommunityMenu = communityMenu ? initCommunityMenu(communityMenu) : undefined;

    // Basic i18n toggle navigation
    const i18nToggle = document.getElementById("i18n-toggle");
    if (i18nToggle) {
      i18nToggle.addEventListener("click", (e) => {
        e.preventDefault();
        const href = (e.currentTarget as HTMLAnchorElement).href;
        navigate(href);
      });
    }
  });
</script>

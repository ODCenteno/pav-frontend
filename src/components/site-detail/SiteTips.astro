---
import "./siteTips.css";
import type { RecommendationItem } from "@/types/community.type";

interface Props {
  labels: {
    tips: string;
  };
  recommendations?: RecommendationItem[];
}

const { labels, recommendations = [] } = Astro.props;
const items = recommendations.filter(item => (item.description || "").trim() !== "");
---

<section class="site-tips container">
  <div class="site-tips__container">
    <h2 class="site-tips__title">{labels.tips}</h2>

    <div class="site-tips__grid">
      {items.map(item => (
        <div class="site-tips__item">
          <h3 class="site-tips__label">{item.label}</h3>
          <p class="site-tips__value">{item.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

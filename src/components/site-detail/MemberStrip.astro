---
import "./memberStrip.css";
import "./memberModal.css";
import MemberCards from "./MemberCards";
import { useTranslations } from "@/i18n/utils";
import { renderMarkdown } from "@/utils/markdown";
import type { CommunityMember } from "@/types/community.type";

interface Props {
  title: string;
  members: CommunityMember[];
}

const { title, members } = Astro.props;
const locale = Astro.currentLocale || "es";
const t = useTranslations(locale);

// Islands can't call t() at runtime — resolve every label here, at build
// time, and hand them over as plain props.
const labels = {
  close: t("siteDetailPage.memberModal.close"),
  gallery: t("siteDetailPage.memberModal.gallery"),
  openProfile: t("siteDetailPage.memberModal.openProfile"),
  call: t("siteDetailPage.actions.call"),
  email: t("siteDetailPage.actions.email"),
  locality: {
    "agua-verde": t("siteDetailPage.memberModal.localityAguaVerde"),
    "rancho-san-cosme": t("siteDetailPage.memberModal.localityRanchoSanCosme"),
  } as Record<string, string>,
};

// Pre-render markdown to HTML on the server: the island receives plain
// strings and ships zero markdown code to the client.
const membersVm = members.map((m) => ({
  id: m.id,
  name: m.name,
  role: m.role,
  locality: m.locality,
  pullQuote: m.pullQuote,
  bioHtml: m.bio ? renderMarkdown(m.bio) : undefined,
  legacyNote: m.legacyNote,
  photo: m.photo,
  galleryUrls: m.galleryUrls ?? [],
  social: m.social ?? [],
}));
---

<section class="member-strip container">
  <h2 class="member-strip__title">{title}</h2>
  <MemberCards client:visible members={membersVm} labels={labels} />
</section>

---
import "./communityHero.css";
import { useTranslations } from "@/i18n/utils";

interface Props {
  name: string;
  image?: string;
  locale: string;
}

const { name, image, locale } = Astro.props;
const t = useTranslations(locale);
---

{image && (
  <div class="community-hero">
    <img
      class="community-hero__image"
      src={image}
      alt={t("communityDetail.heroAlt", { name })}
      fetchpriority="high"
      decoding="async"
    />
  </div>
)}

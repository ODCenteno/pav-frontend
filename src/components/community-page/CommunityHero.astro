---
import "./communityHero.css";
import { useTranslations } from "@/i18n/utils";
import { imageAttrs, type ResponsiveImageMap } from "@/utils/responsiveImage";

interface Props {
  name: string;
  image?: string;
  /** Strapi formats of the community images, keyed by URL. */
  imageSources?: ResponsiveImageMap;
  locale: string;
}

const { name, image, imageSources, locale } = Astro.props;
const t = useTranslations(locale);
---

{image && (
  <div class="community-hero">
    <img
      class="community-hero__image"
      {...imageAttrs(image, imageSources, "100vw")}
      alt={t("communityDetail.heroAlt", { name })}
      fetchpriority="high"
      decoding="async"
    />
  </div>
)}

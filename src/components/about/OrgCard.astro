---
import type { Organization } from "../../types/about.type";
import { useTranslations } from "../../i18n/utils";
import { renderMarkdown } from "@/utils/markdown";
import "./orgCard.css";

interface Props {
  org: Organization;
  locale: string;
}

const { org, locale } = Astro.props;
const t = useTranslations(locale);
const description = org?.shortDescription ? (org.shortDescription[locale as "es-MX" | "en"] || "") : "";

// Strapi may store either a bare handle or a full URL — normalize both.
// (startsWith instead of a regex: astro-eslint-parser mis-lexes
// regex + template-literal combinations in frontmatter.)
const hasProtocol = (v: string) => v.startsWith("http://") || v.startsWith("https://");
const asUrl = (value?: string) => {
  const v = value?.trim();
  if (!v) return undefined;
  return hasProtocol(v) ? v : `https://${v}`;
};
const instagramUrl = (value?: string) => {
  const v = value?.trim().replace(/^@/, "");
  if (!v) return undefined;
  return hasProtocol(v) ? v : `https://instagram.com/${v}`;
};
const facebookUrl = (value?: string) => {
  const v = value?.trim();
  if (!v) return undefined;
  return hasProtocol(v) ? v : `https://facebook.com/${v}`;
};

const typeLabels: Record<NonNullable<Organization["type"]>, string> = {
  community: t("aboutPage.organizations.type.community"),
  institution: t("aboutPage.organizations.type.institution"),
  partner: t("aboutPage.organizations.type.partner"),
  collective: t("aboutPage.organizations.type.collective"),
  business: t("aboutPage.organizations.type.business"),
};
const typeLabel = org?.type ? typeLabels[org.type] || "" : "";

const website = asUrl(org?.links?.website);
const instagram = instagramUrl(org?.links?.instagram);
const facebook = facebookUrl(org?.links?.facebook);
const hasLinks = Boolean(website || instagram || facebook);
---

<div class="org-card">
  {org?.logo && (
    <div class="org-card__logo-container">
      <img src={org.logo} alt={org.name} class="org-card__logo" />
    </div>
  )}
  <div class="org-card__content">
    {(typeLabel || org?.isFeatured) && (
      <div class="org-card__badges">
        {typeLabel && <span class="org-card__badge">{typeLabel}</span>}
        {org?.isFeatured && (
          <span class="org-card__badge org-card__badge--featured">
            {t("aboutPage.organizations.featured")}
          </span>
        )}
      </div>
    )}
    <h3 class="org-card__name">{org?.name || t("aboutPage.organizations.orgFallback")}</h3>
    {description && <div class="org-card__description prose" set:html={renderMarkdown(description)} />}
    {hasLinks && (
      <div class="org-card__links">
        {website && (
          <a href={website} target="_blank" rel="noopener noreferrer" class="org-card__link">
            {t("aboutPage.organizations.visitWebsite")}
          </a>
        )}
        {instagram && (
          <a href={instagram} target="_blank" rel="noopener noreferrer" class="org-card__social-link" aria-label="Instagram">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
          </a>
        )}
        {facebook && (
          <a href={facebook} target="_blank" rel="noopener noreferrer" class="org-card__social-link" aria-label="Facebook">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
          </a>
        )}
      </div>
    )}
  </div>
</div>

---
/**
 * OfflineReadyToast.astro
 *
 * Listens for service-worker messages and shows a transient one-time toast
 *   • `PRECACHE_COMPLETE`  → background cache finished, "Ready offline ✓"
 *   • `SW_UPDATED`         → new service worker installed, prompt to reload
 *
 * Compact, bottom-right. Transient toasts auto-hide after ~5 s
 * (toastController.ts); the close button dismisses any of them.
 */
---

<div
  id="offline-ready-toast"
  class="offline-toast"
  role="status"
  aria-live="polite"
  hidden
>
  <span class="offline-toast__icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
  </span>
  <span class="offline-toast__message" id="offline-ready-toast__message"></span>
  <button
    type="button"
    class="offline-toast__close"
    id="offline-ready-toast__close"
    aria-label="Dismiss"
  >
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
  </button>
</div>

<script>
  import { createToastController } from "./toastController";

  // Texts live here (not i18n) because the service worker message can land
  // on any page; the language comes from <html lang>.
  const TEXTS = {
    precacheComplete: {
      es: "Guía lista para usar sin conexión",
      en: "Guide ready to use offline",
    },
    swUpdated: {
      es: "Hay una nueva versión disponible. Recarga para actualizar.",
      en: "A new version is available. Reload to update.",
    },
  };

  const toast = createToastController(() => {
    const el = document.getElementById("offline-ready-toast");
    const message = document.getElementById("offline-ready-toast__message");
    return el && message ? { toast: el, message } : null;
  });

  const lang = () => ((document.documentElement.lang || "es").startsWith("en") ? "en" : "es");

  // View-transition safe: re-bind the close button after every page swap.
  const bindToast = () => {
    const close = document.getElementById("offline-ready-toast__close");
    if (!close) return;
    close.setAttribute("aria-label", lang() === "en" ? "Dismiss" : "Cerrar");
    if (close.dataset.bound === "1") return;
    close.addEventListener("click", () => toast.close());
    close.dataset.bound = "1";
  };
  bindToast();
  document.addEventListener("astro:page-load", bindToast);

  // One listener on the persistent serviceWorker container.
  if ("serviceWorker" in navigator) {
    navigator.serviceWorker.addEventListener("message", (event) => {
      const type = event.data?.type;
      if (type === "PRECACHE_COMPLETE") toast.show(TEXTS.precacheComplete[lang()], type);
      if (type === "SW_UPDATED") toast.show(TEXTS.swUpdated[lang()], type, { sticky: true });
    });
  }
</script>

<style is:global>
  /* Compact, bottom-right inside the 16px gutter, narrow enough to leave
     the hero cards' labels clear on phones. */
  .offline-toast {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 10000;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: max-content;
    max-width: min(15rem, calc(100vw - 2rem));
    padding: 0.5rem 0.25rem 0.5rem 0.75rem;
    background: var(--color-charcoal, #1a1a1a);
    color: var(--color-white, #fff);
    border-radius: 0.875rem;
    box-shadow: 0 10px 24px -8px rgba(0, 0, 0, 0.35);
    font-size: 0.8125rem;
    line-height: 1.35;
    animation: offline-toast-in 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .offline-toast[hidden] {
    display: none;
  }

  .offline-toast__icon {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50%;
    background: var(--color-primary, #5a8a80);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .offline-toast__close {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin: -0.25rem 0;
    background: none;
    border: none;
    border-radius: 50%;
    color: inherit;
    cursor: pointer;
    font-size: 1.125rem;
    line-height: 1;
    opacity: 0.75;
  }

  .offline-toast__close:hover {
    opacity: 1;
  }

  .offline-toast__close:focus-visible {
    outline: 2px solid var(--color-white, #fff);
    outline-offset: -4px;
    opacity: 1;
  }

  @keyframes offline-toast-in {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .offline-toast {
      animation: none;
    }
  }
</style>

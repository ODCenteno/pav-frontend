---
import "./guideTouristMap.css";
import ExpandableImage from "./ExpandableImage";
import { useTranslations } from "@/i18n/utils";

interface Props {
  data: {
    title: { 'es-MX': string; en: string };
    image: string;
    caption: { 'es-MX': string; en: string };
  };
  locale?: string;
}

const { data, locale = "es-MX" } = Astro.props;
const lang = locale?.startsWith("en") ? "en" : "es-MX";
const t = useTranslations(locale);
---

<section class="guide-tourist-map section-padding">
  <div class="container">
    <header class="guide-tourist-map__header">
      <h2 class="guide-tourist-map__title">{data.title[lang]}</h2>
    </header>

    <figure class="guide-tourist-map__figure">
      <ExpandableImage
        client:visible
        className="guide-tourist-map__image-wrap"
        imgClassName="guide-tourist-map__image"
        src={data.image}
        alt={data.title[lang]}
        expandLabel={`${t("guidePage.expandMap")}: ${data.title[lang]}`}
      />
      <figcaption class="guide-tourist-map__caption">{data.caption[lang]}</figcaption>
    </figure>
  </div>
</section>

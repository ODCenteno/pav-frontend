---
import "./cardsMain.css";
import type { Listing } from "../../types/listing.type";
import type { LocalizedString } from "../../types/i18n.type";
import Socials from "./Socials.astro";
import { cardContactInfo } from "./socialLinks";
import CommunityBadge from "@/components/community-badge/CommunityBadge.astro";
import { communityStyle } from "@/utils/communityTheme";
import { carouselCategoryOf } from "@/components/main/categories/carousel";
import { useTranslations } from "@/i18n/utils";
import SvgIcon from "../icons/SvgIcon.astro";
import { navigation } from "@/utils/navigation";
import { renderMarkdown, stripMarkdown } from "@/utils/markdown";
import { imageAttrs } from "@/utils/responsiveImage";

// Props. `sizes` defaults to the carousel slot (300px, 340px from 768px).
const {
  item,
  currentLang,
  sizes = "(min-width: 768px) 340px, 300px",
} = Astro.props as { item: Listing; currentLang: string; sizes?: string };

// Locale -> key interno ("en" | "es-MX") para LocalizedString
const langKey = String(currentLang).toLowerCase().startsWith("en") ? "en" : "es-MX";

// Helper local (SSR) para leer LocalizedString de forma segura
function getLocalizedText(value?: LocalizedString, key: string = "es-MX"): string {
  if (!value) return "";
  if (typeof value === "object") {
    const v = (value as any)[key] ?? (value as any)["es-MX"] ?? (value as any).en;
    return typeof v === "string" ? v : "";
  }
  return typeof value === "string" ? value : "";
}

// Textos principales
const title = getLocalizedText(item.name, langKey);
const shortDesc = getLocalizedText(item.shortDescription, langKey);
const desc = getLocalizedText(item.description, langKey);
const descHtml = renderMarkdown(desc);
const searchDesc = stripMarkdown(desc).toLowerCase();

// Alt text: preferimos shortDescription, si no, title
const altText = shortDesc || title || "";

// Tags (string[] — single localized label per tag)
const tags = (item.tags ?? []).map((t) => String(t ?? "").trim()).filter(Boolean);

// Media: intentamos varias formas (modelo nuevo y legacy) para no romper MVP
const mainImageUrl =
  // mock data primary field
  (item as any).image ||
  // modelo nuevo (si existe)
  (item.media as any)?.mainImageUrl ||
  (item.media as any)?.mainImage?.url ||
  (item.media as any)?.images?.[0]?.url ||
  // legacy (por compatibilidad temporal)
  (item as any).main_image_url ||
  (item as any).mainImageUrl ||
  "";

// Responsive sources (Strapi formats) when the CMS provides them.
const mainImage = imageAttrs(mainImageUrl, item.imageSources, sizes);

// Pricing: intenta modelo nuevo y legacy
const price = (item.pricing as any)?.price ?? (item.pricing as any)?.amount ?? (item as any).price ?? null;

// Contact channels (hidden for `hideContact` listings)
const socialInfo = cardContactInfo(item);

// Kept as data (drives the home carousel); the star badge is gone from the UI.
const isFeatured = item.isFeatured ?? (item as any).is_featured ?? false;

// Community theme: --community-color / --community-color-text
const themeStyle = communityStyle(item.community);

// Labels UI (idealmente se moverán a translations, pero quedan correctos por locale)
// Toggle button: a constant label, with the saved state in aria-pressed.
const t = useTranslations(langKey);
const favLabel = t("featured.favorite");

// Detail link construction
const detailLink = item.href ? (item.href as any)[langKey] : navigation.siteDetail(item.slug, langKey);

// Create a clean data object for the popup (avoid complex nested objects in data attributes)
const cardData = {
  id: item.id,
  name: item.name,
  description: item.description,
  shortDescription: item.shortDescription,
  mainImageUrl: mainImage.src,
  pricing: { price: price },
  categoryId: item.category?.slug || '',
  category: item.category,
  type: item.type,
  slug: item.slug,
};
// Escape JSON for safe HTML attribute usage
const cardDataJson = JSON.stringify(cardData).replace(/"/g, '&quot;').replace(/'/g, '&#39;');
---

<div class="listing-card-container" style={themeStyle} data-category={carouselCategoryOf(item)} data-name={title.toLowerCase()} data-description={searchDesc}>
  <article
    class="listing-card"
    data-listing-type={item.type}
    data-is-featured={isFeatured}
    data-card-item={cardDataJson}
    onclick={`window.location.assign('${detailLink}')`}
  >
    <div class="listing-image-container">
      {mainImageUrl ? <img {...mainImage} alt={altText} loading="lazy" decoding="async" /> : <div class="listing-image--placeholder" aria-label={altText} />}

      <CommunityBadge community={item.community} size="sm" locale={langKey} class="listing-community-badge" />

      <button type="button" class="fav-btn" data-fav-id={item.id} aria-pressed="false" aria-label={favLabel} title={favLabel} onclick="event.stopPropagation(); window.toggleFav(this)">
        <SvgIcon name="bookmark-outline" class="bookmark-icon icon-outline" />
        <SvgIcon name="bookmark-filled" class="bookmark-icon icon-filled" />
      </button>
    </div>

    <div class="listing-content">
      <div class="listing-content__tag-price">
        {
          tags.length > 0 && (
            <div class="listing-tags" aria-label={langKey === "en" ? "Tags" : "Etiquetas"}>
              {tags.slice(0, 2).map((tag) => (
                <span class="listing-tag">{tag}</span>
              ))}
            </div>
          )
        }
      </div>

      <h3 class="listing-title">{title}</h3>
      {descHtml && <div class="listing-desc prose" set:html={descHtml} />}

      <div class="listing-footer">
        <Socials socialInfo={socialInfo} detailLink={detailLink} />
      </div>
    </div>
  </article>
</div>

<script>
  import { isFavorite, toggleFavorite } from "../../utils/favorites";

  function updateAllFavButtons() {
    const buttons = document.querySelectorAll(".fav-btn");
    buttons.forEach((btn) => {
      const id = btn.getAttribute("data-fav-id");
      const saved = Boolean(id && isFavorite(id));
      btn.classList.toggle("is-favorite", saved);
      btn.setAttribute("aria-pressed", String(saved));
    });
  }

  // Global function for onclick
  (window as any).toggleFav = function(el: HTMLElement) {
    const id = el.getAttribute("data-fav-id");
    if (id) {
      const isAdded = toggleFavorite(id);
      el.classList.toggle("is-favorite", isAdded);
      el.setAttribute("aria-pressed", String(isAdded));
    }
  };

  // Sync state on load
  document.addEventListener("DOMContentLoaded", updateAllFavButtons);
  document.addEventListener("astro:page-load", updateAllFavButtons);
  
  // Listen for updates from other components
  window.addEventListener("favorites-updated", updateAllFavButtons);
</script>

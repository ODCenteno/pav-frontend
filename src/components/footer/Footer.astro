---
import "@/components/footer/footer.css";
import { useTranslations } from "../../i18n/utils";
import { navigation, communityPath, goodPracticesPath, favoritesPath } from "@/utils/navigation";
import { getSiteSettings } from "@/lib/cms";
import { getSiteContents, toStrapiLocale } from "@/lib/cms";
import { getCommunities } from "@/lib/cms/community";

const locale = Astro.currentLocale || "es";
const t = useTranslations(locale);

const [settings, footerContents, communities] = await Promise.all([
  getSiteSettings(),
  getSiteContents(["footer-about"], toStrapiLocale(locale)),
  getCommunities(locale),
]);

const footerAbout = footerContents[0];

const aboutTitle = footerAbout?.title?.[locale === "en" ? "en" : "es-MX"] || t("footer.aboutTitle");
const aboutText = footerAbout?.text?.[locale === "en" ? "en" : "es-MX"] || t("footer.desc");
const aboutThanks = footerAbout?.extraData?.thanks?.[locale === "en" ? "en" : "es-MX"] || t("footer.thanks");
const aboutRights = footerAbout?.extraData?.rights?.[locale === "en" ? "en" : "es-MX"] || t("footer.rights");
const aboutLegal = footerAbout?.extraData?.legal?.[locale === "en" ? "en" : "es-MX"] || t("footer.legal");

const currentYear = new Date().getFullYear();
---

<footer class="footer-main">
<div class="footer-wave" aria-hidden="true">
    <svg viewBox="0 0 1440 40" preserveAspectRatio="none" fill="none">
      <path d="M0,15 C240,35 480,-5 720,15 C960,35 1200,-5 1440,15 L1440,0 L0,0 Z" fill="#FDFCF8"></path>
    </svg>
  </div>
  <div class="container footer-grid">
    <div class="footer-col footer-about">
      <h3 class="footer__about-title" data-key="footer_about_title">
        {aboutTitle}
      </h3>
      <p data-key="footer_desc">{aboutText}</p>
      <p data-key="footer_thanks">{aboutThanks}</p>
    </div>
    <nav class="footer-col" aria-label={t("footer.title")}>
      <h3 class="footer_title" data-key="footer_title">{t("footer.title")}</h3>
      <ul class="footer__list">
        <li><a class="footer-link" href={goodPracticesPath(locale)} data-key="footer_link_good_practices">{t("footer.goodPractices")}</a></li>
        {communities.map((community) => (
          <li><a class="footer-link" href={communityPath(community.slug, locale)}>{community.name}</a></li>
        ))}
        <li><a class="footer-link" href={favoritesPath(locale)} data-key="footer_link_favorites">{t("nav.favorites")}</a></li>
        <li><a class="footer-link" href={navigation.sites(locale)} data-key="footer_link_sites">{t("nav.sites")}</a></li>
      </ul>
    </nav>
  </div>
  <div class="footer-bottom">
    <p class="footer-rights" data-key="footer_rights">© {currentYear} {settings.metadata.siteName}. {aboutRights}</p>

    <a class="footer-legal footer-link" href={navigation.legal("privacy-notice", locale)} data-key="footer_legal">{aboutLegal}</a>
  </div>
</footer>
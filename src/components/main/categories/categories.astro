---
/**
 * Home featured carousel: featured listings from both communities, rendered
 * through the reusable ListingCarousel.
 */
import { useTranslations } from "@/i18n/utils";
import { getListingsWithFallback, toStrapiLocale } from "@/lib/cms";
import { navigation } from "@/utils/navigation";
import ListingCarousel from "./ListingCarousel.astro";
import { featuredListings } from "./carousel";

const locale = Astro.currentLocale ?? "es";
const t = useTranslations(locale);

const listings = featuredListings(await getListingsWithFallback(toStrapiLocale(locale)));
---

<ListingCarousel
  id="category-carousel"
  listings={listings}
  title={t("gallery.title")}
  subtitle={t("gallery.desc")}
  locale={locale}
  viewAllHref={navigation.sites(locale)}
/>

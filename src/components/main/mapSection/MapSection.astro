---
/**
 * MapSection.astro — Homepage map block (F2).
 *
 *   1. Header (eyebrow + title + description)
 *   2. Split: the static BCS/Loreto region map (`homepage.regionMapImage`) on
 *      the left, the Leaflet map with one pin per community on the right.
 *      Stacked on mobile.
 *   3. Legend (badge, color and name per community) and one Google Maps
 *      button per community, in its color, opening in a new tab.
 *
 * Pins come from `community.location`; each popup links to the community page.
 */
import "./mapSection.css";
import MapView from "@/components/maps/MapView.tsx";
import { useTranslations } from "@/i18n/utils";
import type { MapSectionData } from "@/types/homepage.type";
import type { Community } from "@/types/community.type";
import CommunityBadge from "@/components/community-badge/CommunityBadge.astro";
import { communityStyle } from "@/utils/communityTheme";
import { communityMapLinks, communityMapMarkers } from "./communityPins";

interface Props {
  data: MapSectionData;
  communities: Community[];
  regionMapImage?: string;
  regionMapImageAlt?: string;
  locale?: string;
}

const { data, communities, regionMapImage, regionMapImageAlt, locale = "es-MX" } = Astro.props;

const t = useTranslations(locale);
const lang = locale.startsWith("en") ? "en" : "es-MX";

const pins = communityMapMarkers(communities, locale);
const mapLinks = communityMapLinks(communities);

const FALLBACK_CENTER: [number, number] = [25.545, -111.12];
const center: [number, number] =
  data.centerPoint && typeof data.centerPoint.lat === "number" && typeof data.centerPoint.lng === "number"
    ? [data.centerPoint.lat, data.centerPoint.lng]
    : FALLBACK_CENTER;

const zoom = typeof data.zoom === "number" ? data.zoom : 11;

const title = (data.title ?? "").trim();
const description = (data.description ?? "").trim();
---

<section class="map-section section-padding" aria-labelledby="map-section-title">
  <div class="container map-section__header">
    <p class="map-section__eyebrow">{t("map.eyebrow")}</p>
    <h2 id="map-section-title" class="map-section__title" data-key="map_title">
      {title || (lang === "en" ? "Explore the destination" : "Explora el destino")}
    </h2>
    {description && (
      <p class="map-section__description" data-key="map_desc">
        {description}
      </p>
    )}
  </div>

  <div class="container map-section__split">
    {regionMapImage && (
      <figure class="map-section__region">
        <img src={regionMapImage} alt={regionMapImageAlt || t("map.regionMapAlt")} loading="lazy" decoding="async" />
      </figure>
    )}

    <div class="map-section__map-wrapper">
      <div class="map-section__map">
        <MapView
          client:only="react"
          markers={pins}
          center={center}
          zoom={zoom}
          height="100%"
          locale={locale}
          linkLabel={t("map.communityLink")}
        />
      </div>
    </div>
  </div>

  {mapLinks.length > 0 && (
    <div class="container map-section__footer">
      <ul class="map-section__legend" aria-label={t("map.communitiesTitle")}>
        {mapLinks.map((link) => (
          <li class="map-section__legend-item" style={communityStyle(link.community)}>
            <span class="map-section__swatch" aria-hidden="true"></span>
            <CommunityBadge community={link.community} size="sm" locale={locale} decorative />
            <span class="map-section__legend-name">{link.name}</span>
          </li>
        ))}
      </ul>

      <ul class="map-section__actions">
        {mapLinks.map((link) => (
          <li>
            <a class="map-section__community-btn" style={communityStyle(link.community)} href={link.href} target="_blank" rel="noopener noreferrer">
              <span>{t("map.openInGoogleMaps", { name: link.name })}</span>
              <span class="sr-only">{t("map.newTab")}</span>
              <span class="map-section__external" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7"></path><path d="M8 7h9v9"></path></svg>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  )}
</section>

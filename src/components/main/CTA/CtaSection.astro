---
/**
 * Closing CTA panel, shared by the home, the community pages and the good
 * practices page.
 *
 * One or two actions. A community action takes that community's color and
 * badge; an unthemed action uses the site primary pair. The two-color bar on
 * top echoes the home hero split.
 */
import "./ctaSection.css";
import CommunityBadge from "@/components/community-badge/CommunityBadge.astro";
import SvgIcon from "@/components/icons/SvgIcon.astro";
import { communityStyle } from "@/utils/communityTheme";
import { communities as communityFixtures } from "@/data/communities";
import { ctaActionsOf, type CtaAction } from "./ctaActions";

interface Props {
  title: string;
  description?: string;
  actions: CtaAction[];
  locale?: string;
}

const { title, description, actions, locale = Astro.currentLocale ?? "es-MX" } = Astro.props;
const items = ctaActionsOf(actions);
const layout = items.length > 1 ? "pair" : "single";
const [first, second] = communityFixtures;
const splitStyle = `--split-a: ${first.color}; --split-b: ${second.color};`;
---

<section class="cta-panel-section section-padding">
  <div class="container">
    <div class={`cta-panel cta-panel--${layout}`} style={splitStyle}>
      <div class="cta-panel__copy">
        <h2 class="cta-panel__title" data-key="final_cta_title">{title}</h2>
        {description && <p class="cta-panel__description" data-key="final_cta_desc">{description}</p>}
      </div>

      <ul class="cta-panel__actions">
        {items.map((action) => (
          <li>
            <a class="cta-panel__action" href={action.href} style={communityStyle(action.community)} data-key="final_cta_btn">
              {action.community ? (
                <span class="cta-panel__mark">
                  <CommunityBadge community={action.community} size="sm" locale={locale} decorative />
                </span>
              ) : (
                action.icon && (
                  <span class="cta-panel__mark cta-panel__mark--icon" aria-hidden="true">
                    <SvgIcon name="bookmark-filled" class="cta-panel__icon" />
                  </span>
                )
              )}
              <span class="cta-panel__label">{action.label}</span>
              <span class="cta-panel__arrow" aria-hidden="true"><SvgIcon name="arrow-right" /></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

---
import "./heroPage.css";

interface Props {
  title: string;
  description?: string;
  backgroundImage?: string;
}

const { 
  title, 
  description, 
  backgroundImage = "/images/pav-landscape-12.webp" 
} = Astro.props;
---

<section class="hero-page" style={`--hero-bg: url('${backgroundImage}')`}>
  <div class="hero-page__overlay"></div>
  <div class="hero-page__container">
    <div class="hero-page__content">
      <h1 class="hero-page__title" set:html={title} />
      <p class="hero-page__desc">{description}</p>
    </div>
  </div>
  <div class="hero-wave" aria-hidden="true">
    <svg viewBox="0 0 1440 40" preserveAspectRatio="none" fill="none">
      <path d="M0,25 C240,45 480,5 720,25 C960,45 1200,5 1440,25 L1440,40 L0,40 Z" fill="#FDFCF8"></path>
    </svg>
  </div>
</section>

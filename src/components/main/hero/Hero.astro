---
/**
 * Home hero.
 *
 * - Mobile: the shared title and description, plus one photo card per
 *   community with its badge and a single explore label.
 * - Desktop (>= 968px): the split, one photo half per community with its
 *   name, tagline and explore button. The hovered or focused half widens.
 *   The shared h1 stays in the outline but is visually hidden: the split
 *   carries the visuals.
 */
import "./hero.css";
import { useTranslations } from "../../../i18n/utils";
import { communityPath } from "@/utils/navigation";
import { communityStyle } from "@/utils/communityTheme";
import CommunityBadge from "@/components/community-badge/CommunityBadge.astro";
import SvgIcon from "@/components/icons/SvgIcon.astro";
import { heroCtaKey } from "./heroLabels";
import type { HeroData } from "@/types/homepage.type";
import type { Community } from "@/types/community.type";

interface Props {
  data: HeroData;
  communities: Community[];
}

const { data, communities } = Astro.props;
const locale = Astro.currentLocale || "es";
const t = useTranslations(locale);
---

<section class="hero">
  <div class="hero-content">
    <h1 class="hero-title" data-key="hero_title">
      {data.title}{" "}
      {data.titleHighlight && <span class="highlight-text">{data.titleHighlight}</span>}
    </h1>
    <p class="hero-desc" data-key="hero_desc">{data.description}</p>

    <ul class="hero-community-buttons">
      {communities.map((community) => (
        <li>
          <a class="hero-community-card" style={communityStyle(community)} href={communityPath(community.slug, locale)}>
            {community.heroImage && <img class="hero-community-card__image" src={community.heroImage} alt="" loading="eager" decoding="async" />}
            <span class="hero-community-card__badge">
              <CommunityBadge community={community} size="lg" locale={locale} decorative />
            </span>
            <span class="hero-community-card__label">{t(heroCtaKey(community.slug))}{" "}<span class="sr-only">{community.name}</span><span class="hero-community-card__arrow" aria-hidden="true"><SvgIcon name="arrow-right" class="hero-arrow" /></span></span>
          </a>
        </li>
      ))}
    </ul>
  </div>

  <div class="hero-split">
    {communities.map((community) => (
      <article class="hero-half" style={communityStyle(community)}>
        {community.heroImage && <img class="hero-half__image" src={community.heroImage} alt="" loading="eager" decoding="async" fetchpriority="high" />}
        <div class="hero-half__content">
          <span class="hero-half__badge">
            <CommunityBadge community={community} size="lg" locale={locale} decorative />
          </span>
          <h2 class="hero-half__name">{community.name}</h2>
          {community.tagline && <p class="hero-half__tagline">{community.tagline}</p>}
          <a class="hero-half__cta" href={communityPath(community.slug, locale)}>
            <span>{t(heroCtaKey(community.slug))}</span>
            <span class="sr-only">{community.name}</span>
            <span class="hero-half__cta-arrow" aria-hidden="true"><SvgIcon name="arrow-right" class="hero-arrow" /></span>
          </a>
        </div>
      </article>
    ))}
  </div>
</section>

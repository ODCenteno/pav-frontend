---
/**
 * "Lo esencial de un vistazo" fact cards.
 *
 * Renders every item it receives. An optional community `theme` recolors the
 * accent card and the values (agent C reuses it on community pages); without
 * it the site palette applies.
 */
import "./quickFacts.css";
import type { SectionHeader, QuickFact } from "@/types/homepage.type";
import type { CommunityRef } from "@/types/community.type";
import { communityStyle } from "@/utils/communityTheme";

interface Props {
  header: SectionHeader;
  items: QuickFact[];
  theme?: CommunityRef | null;
}

const { header, items, theme } = Astro.props;
---

<section class="quick-facts section-padding" style={theme ? communityStyle(theme) : undefined}>
  <div class="container">
    <div class="section-header">
      <h2 class="quick-facts__title">{header.title}</h2>
      {header.subtitle && <p class="quick-facts__subtitle">{header.subtitle}</p>}
    </div>

    <div class="quick-facts__bento">
      {items.map((item, i) => (
        <div class={`quick-facts__card${i === 0 ? " fact-accent-1" : ""}`}>
          <div class="quick-facts__card-content">
            <h3 class="quick-facts__card-title">{item.title}</h3>
            <div class="quick-facts__card-value">{item.value}</div>
            <p class="quick-facts__card-desc">{item.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

---
import "./expCTA.css";

interface Props {
  title: string;
  description: string;
  btnText: string;
  href: string;
  padded?: boolean;
}

const { title, description, btnText, href, padded = true } = Astro.props;
---

<section class:list={["exp-cta", padded && "section-padding"]}>
  <div class="exp-cta__container container">
    <h2 class="exp-cta__title">{title}</h2>
    <p class="exp-cta__desc">{description}</p>
    <a href={href} class="btn btn-accent">{btnText}</a>
  </div>
</section>

---
/**
 * Favorites carousel (brief C3 · F8), rendered on /favoritos.
 *
 * Every listing card is rendered on the server and hidden by default; the
 * client script shows the ones saved in localStorage (`utils/favorites`)
 * that match the active chip, using the pure `favoritesViewState` rules.
 */
import "@/components/main/categories/categories.css";
import CardMain from "@/components/cards/CardMain.astro";
import { carouselCategoryOf, carouselChips } from "@/components/main/categories/carousel";
import { useTranslations } from "@/i18n/utils";
import type { Listing } from "@/types/listing.type";

interface Props {
  listings: Listing[];
  /** Strapi locale ("es-MX" | "en"). */
  locale?: string;
}

const { listings, locale = Astro.currentLocale ?? "es-MX" } = Astro.props;
const t = useTranslations(locale);

const chips = [{ id: "all", label: t("categories.all") }, ...carouselChips(locale)];
---

<section class="favorites-section section-padding" id="favorites-section" aria-labelledby="favorites-title">
  <div class="container">
    <div class="section-header">
      <h2 id="favorites-title" class="favorites-title">{t("favoritesPage.title")}</h2>
      <p class="favorites-subtitle">{t("favoritesPage.subtitle")}</p>
    </div>

    <div class="filter-chips" role="group" aria-label={t("favoritesPage.filterLabel")}>
      {chips.map((chip) => (
        <button
          type="button"
          class:list={["chip", { active: chip.id === "all" }]}
          data-category-filter={chip.id}
          aria-pressed={chip.id === "all" ? "true" : "false"}
        >
          {chip.label}
        </button>
      ))}
    </div>

    <div id="favorites-carousel" class="carousel-container" aria-live="polite">
      {listings.map((item) => (
        <div class="carousel-slide" data-fav-id={String(item.id)} data-category={carouselCategoryOf(item)}>
          <CardMain item={item} currentLang={locale} />
        </div>
      ))}
    </div>

    <div
      id="favorites-empty-state"
      class="favorites-empty"
      data-empty-text={t("favoritesPage.empty")}
      data-filter-text={t("favoritesPage.emptyFiltered")}
      hidden
    >
      <p id="favorites-empty-text" class="favorites-empty__text" role="status">{t("favoritesPage.empty")}</p>
    </div>
  </div>
</section>

<style>
  .favorites-title {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-xs);
  }

  .favorites-subtitle {
    color: var(--color-on-surface-variant);
    font-size: var(--text-sm);
    margin: 0 0 var(--space-md);
  }

  /* Cards stay hidden until the script marks them as visible favorites.
     More specific than categories.css `.carousel-container > .carousel-slide`. */
  .favorites-section .carousel-slide:not(.is-favorite-visible) {
    display: none;
  }

  .chip:focus-visible {
    outline: 3px solid var(--color-on-surface);
    outline-offset: 2px;
  }

  .favorites-empty {
    padding: var(--space-xl) var(--space-md);
    text-align: center;
    border: 2px dashed var(--border-color);
    border-radius: var(--radius-lg);
    background: var(--gradient-sea-glass);
  }

  .favorites-empty[hidden] {
    display: none;
  }

  .favorites-empty__text {
    max-width: 440px;
    margin: 0 auto var(--space-md);
    color: var(--color-on-surface);
  }

</style>

<script>
  import { getFavorites } from "@/utils/favorites";
  import { favoritesViewState } from "@/components/main/favorites/favoritesView";

  function initFavoritesSection() {
    const section = document.getElementById("favorites-section");
    if (!section || section.dataset.ready === "true") return;
    section.dataset.ready = "true";

    const slides = Array.from(section.querySelectorAll<HTMLElement>(".carousel-slide[data-fav-id]"));
    const chips = Array.from(section.querySelectorAll<HTMLButtonElement>("[data-category-filter]"));
    const emptyState = section.querySelector<HTMLElement>("#favorites-empty-state");
    const emptyText = section.querySelector<HTMLElement>("#favorites-empty-text");
    const cards = slides.map((el) => ({ id: el.dataset.favId ?? "", category: el.dataset.category ?? "" }));

    let activeFilter = "all";

    function render() {
      const state = favoritesViewState(cards, getFavorites(), activeFilter);
      const visible = new Set(state.visibleIds);
      slides.forEach((el) => el.classList.toggle("is-favorite-visible", visible.has(el.dataset.favId ?? "")));

      if (emptyState) emptyState.hidden = state.empty === "none";
      if (emptyText && emptyState) {
        emptyText.textContent =
          state.empty === "no-matches" ? emptyState.dataset.filterText ?? "" : emptyState.dataset.emptyText ?? "";
      }
    }

    chips.forEach((chip) => {
      chip.addEventListener("click", () => {
        activeFilter = chip.dataset.categoryFilter ?? "all";
        chips.forEach((c) => {
          const active = c === chip;
          c.classList.toggle("active", active);
          c.setAttribute("aria-pressed", String(active));
        });
        render();
      });
    });

    window.addEventListener("favorites-updated", render);
    render();
  }

  document.addEventListener("astro:page-load", initFavoritesSection);
  initFavoritesSection();
</script>
